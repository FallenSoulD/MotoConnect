rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 1. Profil (Users) Koleksiyonu Güvenliği
    match /users/{userId} {
      // Herkes diğer profilleri okuyabilir (Swipe ve Radar için gereklidir)
      allow read: if request.auth != null;
      // Sadece profilin sahibi (oturum açmış kişi) kendi profilini oluşturabilir, silebilir veya güncelleyebilir.
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // 2. Sistem Ayarları (System Config) ve Admin Ayarları (Config)
    match /system_settings/{settingId} {
      allow read: if true;
      allow write: if request.auth != null && (
        request.auth.token.email == 'cenkaliyedek@gmail.com' || 
        request.auth.token.admin == true ||
        request.auth.token.email in get(/databases/$(database)/documents/config/admins).data.emails
      );
    }
    
    match /config/{document=**} {
      allow read: if true;
      allow write: if request.auth != null && (
        request.auth.token.email == 'cenkaliyedek@gmail.com' || 
        request.auth.token.admin == true ||
        request.auth.token.email in get(/databases/$(database)/documents/config/admins).data.emails
      );
    }

    // 3. Geçiş Yolları (Crossed Paths) Koleksiyonu Güvenliği
    match /crossed_paths/{pathId} {
      allow read, write: if request.auth != null;
    }
    
    // 4. Sohbetler (Chats), Sürüşler (Rides), Sinyaller (Signals), Rotalar (Routes) ve Lobiler (Lobbies)
    match /chats/{chatId} {
      allow read, write: if request.auth != null;
    }
    match /rides/{rideId} {
      allow read, write: if request.auth != null;
    }
    match /signals/{signalId} {
      allow read, write: if request.auth != null;
    }
    match /saved_routes/{routeId} {
      allow read, write: if request.auth != null;
    }
    match /live_lobbies/{lobbyId} {
      allow read, write: if request.auth != null;
    }
    
    // 5. Raporlar (Admin Paneli İçin) ve Duyurular
    match /reports/{reportId} {
      allow read: if request.auth != null && (
        request.auth.token.email == 'cenkaliyedek@gmail.com' || 
        request.auth.token.admin == true ||
        request.auth.token.email in get(/databases/$(database)/documents/config/admins).data.emails
      );
      allow write: if request.auth != null; // Kullanıcılar şikayet oluşturabilir
    }
    
    match /announcements/{announceId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && (
        request.auth.token.email == 'cenkaliyedek@gmail.com' || 
        request.auth.token.admin == true ||
        request.auth.token.email in get(/databases/$(database)/documents/config/admins).data.emails
      );
    }
    
    // 6. Genel Yasaklama
    // Yukarıda belirtilmeyen hiçbir koleksiyona erişilemez.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
